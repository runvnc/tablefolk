+// Graphs replay the same dispatches with the same tensors, thousands a second, and a
+// bind group is costly to make (a browser round trip through JS and the GPU process).
+// Keyed by pipeline and entries; the entries' buffer refs keep their handles from being
+// reused. Emptied whenever a buffer is freed.
+struct webgpu_bind_group_cache {
+    struct item {
+        wgpu::ComputePipeline             pipeline;
+        std::vector<wgpu::BindGroupEntry> entries;
+        wgpu::BindGroup                   group;
+    };
+    std::unordered_map<uint64_t, std::vector<item>> table;
+    size_t                                          count = 0;
+
+    static uint64_t mix(uint64_t h, uint64_t v) { return (h ^ v) * 1099511628211ULL; }
+    static uint64_t hash(const wgpu::ComputePipeline & p, const std::vector<wgpu::BindGroupEntry> & es) {
+        uint64_t h = mix(1469598103934665603ULL, (uint64_t) (uintptr_t) p.Get());
+        for (const auto & e : es) {
+            h = mix(mix(mix(mix(h, e.binding), (uint64_t) (uintptr_t) e.buffer.Get()), e.offset), e.size);
+        }
+        return h;
+    }
+    static bool same(const std::vector<wgpu::BindGroupEntry> & a, const std::vector<wgpu::BindGroupEntry> & b) {
+        if (a.size() != b.size()) return false;
+        for (size_t i = 0; i < a.size(); i++) {
+            if (a[i].binding != b[i].binding || a[i].buffer.Get() != b[i].buffer.Get() || a[i].offset != b[i].offset ||
+                a[i].size != b[i].size) {
+                return false;
+            }
+        }
+        return true;
+    }
+    void clear() { table.clear(); count = 0; }
+};
