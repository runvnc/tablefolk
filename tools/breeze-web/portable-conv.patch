+// Portable convolutions: ggml's WebGPU backend (the browser build) has no
+// CONV_TRANSPOSE_1D and no ROLL, so there the codec writes them with ops it
+// has (mul_mat, pad, add, permute). Always on under Emscripten; elsewhere
+// BREEZE_PORTABLE_CONV=1 turns it on, to compare against the native ops.
+static bool portable_conv() {
+#ifdef __EMSCRIPTEN__
+    return true;
+#else
+    static const bool on = std::getenv("BREEZE_PORTABLE_CONV") != nullptr;
+    return on;
+#endif
+}
+
+// conv_transpose_1d(w [K, Cout, Cin], x [L, Cin], stride s) -> [(L-1)*s + K, Cout],
+// for K a multiple of s: every input frame times the kernel gives K*Cout values
+// (one mul_mat); output frame m sums kernel slice j of input frame m - j.
+static ggml_tensor * convtr1d_mm(ggml_context * ctx, ggml_tensor * w, ggml_tensor * x, int s) {
+    const int64_t K = w->ne[0], Cout = w->ne[1], Cin = w->ne[2], L = x->ne[0], J = K / s;
+    ggml_tensor * wm = ggml_reshape_2d(ctx, ggml_cont(ctx, ggml_permute(ctx, w, 1, 2, 0, 3)), Cin, K * Cout);
+    ggml_tensor * xt = ggml_cont(ctx, ggml_transpose(ctx, x));                       // [Cin, L]
+    ggml_tensor * p = ggml_reshape_3d(ctx, ggml_mul_mat(ctx, wm, xt), K, Cout, L);   // [K, Cout, L]
+    ggml_tensor * acc = nullptr;
+    for (int64_t j = 0; j < J; j++) {
+        ggml_tensor * v = ggml_cont(ctx, ggml_view_3d(ctx, p, s, Cout, L, p->nb[1], p->nb[2], (size_t) (j * s) * p->nb[0]));
+        v = ggml_pad_ext(ctx, v, 0, 0, 0, 0, (int) j, (int) (J - 1 - j), 0, 0);       // [s, Cout, L + J - 1]
+        acc = acc ? ggml_add(ctx, acc, v) : v;
+    }
+    ggml_tensor * q = ggml_cont(ctx, ggml_permute(ctx, acc, 0, 2, 1, 3));             // [s, L + J - 1, Cout]
+    return ggml_reshape_2d(ctx, q, s * (L + J - 1), Cout);
+}
