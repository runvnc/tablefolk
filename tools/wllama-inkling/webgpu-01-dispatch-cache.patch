+// Per-token cost counters, printed every GGML_WEBGPU_STATS graphs (env, or -DGGML_WEBGPU_STATS=N where there is no env).
+struct webgpu_stats {
+    int      every = 0;  // 0 = off
+    uint64_t graphs = 0, nodes = 0, dispatches = 0, bind_groups = 0, bind_group_hits = 0, param_writes = 0,
+             param_bytes = 0, submits = 0, set_tensors = 0, get_tensors = 0, memsets = 0, pipeline_sets = 0, syncs = 0;
+    double   encode_ms = 0, submit_ms = 0, get_ms = 0, set_ms = 0, gap_ms = 0, compute_ms = 0, sync_ms = 0;
+    std::chrono::steady_clock::time_point last_end;
+    bool     have_last = false;
+
+    static double ms_since(std::chrono::steady_clock::time_point t) {
+        return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t).count();
+    }
+
+    void print_and_reset() {
+        const double g = graphs ? (double) graphs : 1.0;
+        GGML_LOG_INFO(
+            "ggml_webgpu stats: %llu graphs; per graph: nodes %.0f dispatches %.0f pipeline_sets %.0f bind_groups new %.0f "
+            "cached %.0f param_writes %.1f (%.0f B) submits %.1f set_tensor %.1f (%.2f ms) get_tensor %.1f (%.2f ms) "
+            "memset %.1f sync %.1f | ms: compute %.2f (encode %.2f submit %.2f) outside %.2f (of it gpu wait %.2f)\n",
+            (unsigned long long) graphs, nodes / g, dispatches / g, pipeline_sets / g, bind_groups / g,
+            bind_group_hits / g, param_writes / g, param_bytes / g, submits / g, set_tensors / g, set_ms / g,
+            get_tensors / g, get_ms / g, memsets / g, syncs / g, compute_ms / g, encode_ms / g, submit_ms / g, gap_ms / g,
+            sync_ms / g);
+        const int  keep      = every;
+        const auto keep_last = last_end;
+        const bool keep_have = have_last;
+        *this                = webgpu_stats();
+        every                = keep;
+        last_end             = keep_last;
+        have_last            = keep_have;
+    }
+};
