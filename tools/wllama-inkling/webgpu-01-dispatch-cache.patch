+// Bind groups keyed by pipeline and every entry (buffer, offset, size): a decode graph has the same
+// shape every token, so its bind groups are made once. Cleared when any WebGPU buffer is freed.
+struct webgpu_bind_group_key {
+    std::vector<uint64_t> words;
+
+    bool operator==(const webgpu_bind_group_key & o) const { return words == o.words; }
+};
+
+struct webgpu_bind_group_key_hash {
+    size_t operator()(const webgpu_bind_group_key & k) const {
+        uint64_t h = 1469598103934665603ull;
+        for (uint64_t w : k.words) {
+            h ^= w + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2);
+            h *= 1099511628211ull;
+        }
+        return (size_t) h;
+    }
+};
