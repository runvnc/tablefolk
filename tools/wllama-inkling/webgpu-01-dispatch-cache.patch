+// Writes the staged parameters of the current batch with one WriteBuffer (queued before the batch's submit).
+static void ggml_backend_webgpu_flush_params(webgpu_context & ctx) {
+    if (ctx->param_staging_end > 0) {
+        ctx->global_ctx->queue.WriteBuffer(ctx->param_arena.buffer, 0, ctx->param_staging.data(), ctx->param_staging_end);
+        ctx->global_ctx->stats.param_writes++;
+        ctx->global_ctx->stats.param_bytes += ctx->param_staging_end;
+        ctx->param_staging_end = 0;
+    }
+}
+
+static void ggml_backend_webgpu_submit_batch(webgpu_context & ctx, uint32_t & num_inflight_batches) {
+    webgpu_stats & st = ctx->global_ctx->stats;
+    const auto     t0 = std::chrono::steady_clock::now();
+    ggml_backend_webgpu_flush_params(ctx);
+    wgpu::CommandBuffer batch_commands = ctx->active_command_encoder.Finish();
+    ggml_backend_webgpu_submit_commands(ctx, batch_commands, num_inflight_batches);
+    st.submits++;
+    st.submit_ms += webgpu_stats::ms_since(t0);
+}
