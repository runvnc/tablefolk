+static std::optional<webgpu_encoded_op> ggml_webgpu_fused(webgpu_context & ctx, const wf_call & c) {
+    static const char * kernels[WF_COUNT] = { wf_wgsl_clip, wf_wgsl_ctrl_out, wf_wgsl_norm2cat, wf_wgsl_conv,
+                                              wf_wgsl_conv, wf_wgsl_situ,     wf_wgsl_moe_sum,  wf_wgsl_mix };
+    const auto & lim   = ctx->global_ctx->capabilities.limits;
+    const size_t align = lim.minStorageBufferOffsetAlignment;
+
+    wgpu::Buffer gb[4];
+    size_t       glo[4] = {}, ghi[4] = {};
+    int          ng = 0;
+    uint32_t     sg[WF_MAX_SLOTS];
+    int          n_slots = 0;
+    for (int k = 0; k < WF_MAX_SLOTS && c.slot[k]; k++) {
+        const ggml_tensor * t   = c.slot[k];
+        wgpu::Buffer        buf = ggml_webgpu_tensor_buf(t);
+        const size_t        lo = wf_off(t), hi = lo + ggml_nbytes(t);
+        int                 g = 0;
+        while (g < ng && gb[g].Get() != buf.Get()) {
+            g++;
+        }
+        if (g == ng) {
+            if (ng == 4) {
+                return std::nullopt;
+            }
+            gb[ng]  = buf;
+            glo[ng] = lo;
+            ghi[ng] = hi;
+            ng++;
+        } else {
+            glo[g] = std::min(glo[g], lo);
+            ghi[g] = std::max(ghi[g], hi);
+        }
+        sg[k]   = g;
+        n_slots = k + 1;
+    }
+    std::vector<uint32_t> params(2 * n_slots);
+    for (int g = 0; g < ng; g++) {
+        glo[g] &= ~(align - 1);
+        if (ROUNDUP_POW2(ghi[g] - glo[g], 4) > lim.maxStorageBufferBindingSize) {
+            return std::nullopt;
+        }
+    }
+    for (int k = 0; k < n_slots; k++) {
+        params[2 * k]     = sg[k];
+        params[2 * k + 1] = (uint32_t) (wf_off(c.slot[k]) - glo[sg[k]]);
+    }
+    params.insert(params.end(), c.p.begin(), c.p.end());
+    if (params.size() > WEBGPU_PARAMS_BUF_SIZE_BYTES / 4) {
+        return std::nullopt;
+    }
+    params.resize(WEBGPU_PARAMS_BUF_SIZE_BYTES / 4, 0);
+
+    if (!ctx->fuse_dummy) {
+        ggml_webgpu_create_buffer(ctx->global_ctx->device, ctx->fuse_dummy, 1024, wgpu::BufferUsage::Storage,
+                                  "ggml_webgpu_fuse_dummy");
+    }
+    std::vector<wgpu::BindGroupEntry> entries;
+    for (int g = 0; g < 4; g++) {
+        if (g < ng) {
+            entries.push_back(ggml_webgpu_make_bind_group_entry(g, gb[g], glo[g], ROUNDUP_POW2(ghi[g] - glo[g], 4)));
+        } else {
+            // one disjoint piece of the dummy buffer per unused binding: writable bindings may not alias
+            entries.push_back(ggml_webgpu_make_bind_group_entry(g, ctx->fuse_dummy, g * 256, 256));
+        }
+    }
+
+    auto it = ctx->fuse_pipelines.find((int) c.type);
+    if (it == ctx->fuse_pipelines.end()) {
+        std::string code = std::string(wf_wgsl_prelude) + kernels[c.type];
+        std::string name = std::string("fused_") + wf_names[c.type];
+        it = ctx->fuse_pipelines.emplace((int) c.type, ggml_webgpu_create_pipeline(ctx->global_ctx->device, code.c_str(),
+                                                                                   name.c_str())).first;
+    }
+    uint32_t wg_x, wg_y;
+    compute_2d_workgroups(std::max(1u, c.wg_x), lim.maxComputeWorkgroupsPerDimension, wg_x, wg_y);
+    ctx->global_ctx->stats.fused[c.type]++;
+    ctx->global_ctx->stats.fused_nodes += c.n_nodes;
+    return ggml_backend_webgpu_build(ctx, it->second, params, entries, wg_x, wg_y);
+}
