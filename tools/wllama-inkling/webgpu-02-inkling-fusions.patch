+// IQ2_XXS tables in workgroup memory for the mat-vec kernels: a module-scope const array indexed at run time is
+// copied into every invocation (2 KB of private memory per thread), which made the IQ2_XXS MUL_MAT_ID vec kernel
+// ~20x slower than its memory traffic. Generated from common_decls.tmpl; filled by fill_iq2xxs_ws, 8 words per thread.
+var<workgroup> iq2xxs_grid_ws: array<u32, 512>;
+var<workgroup> ksigns_iq2xs_ws: array<u32, 32>;
