+static void ggml_backend_webgpu_replay(webgpu_context & ctx, const webgpu_recording & r) {
+    webgpu_global_context & g   = ctx->global_ctx;
+    const uint32_t          per = ctx->replay_batch ? ctx->replay_batch : g->command_submit_batch_size;
+    uint32_t                inflight = 0, in_batch = 0;
+    WGPUComputePipeline     last = nullptr;
+    wgpu::CommandEncoder     enc  = g->device.CreateCommandEncoder();
+    wgpu::ComputePassEncoder pass = enc.BeginComputePass();
+    WGPUComputePassEncoder   p    = pass.Get();
+    const size_t             n    = r.cmds.size();
+    for (size_t i = 0; i < n; i++) {
+        const webgpu_replay_cmd & c = r.cmds[i];
+        if (c.pipeline != last) {
+            wgpuComputePassEncoderSetPipeline(p, c.pipeline);
+            last = c.pipeline;
+        }
+        wgpuComputePassEncoderSetBindGroup(p, 0, c.bind_group.Get(), 0, nullptr);
+        wgpuComputePassEncoderDispatchWorkgroups(p, c.wg_x, c.wg_y, 1);
+        if (++in_batch >= per && i + 1 < n) {
+            pass.End();
+            ggml_backend_webgpu_submit_commands(ctx, enc.Finish(), inflight);
+            g->stats.submits++;
+            enc      = g->device.CreateCommandEncoder();
+            pass     = enc.BeginComputePass();
+            p        = pass.Get();
+            last     = nullptr;
+            in_batch = 0;
+        }
+    }
+    pass.End();
+    ggml_backend_webgpu_submit_commands(ctx, enc.Finish(), inflight);
+    g->stats.submits++;
+    g->stats.dispatches += n;
+}
