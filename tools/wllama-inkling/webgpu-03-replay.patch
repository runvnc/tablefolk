+// Everything a graph's encoding depends on: per node its op, flags, type, shape, strides, buffer and offset, op
+// parameters, and the same for each source (sources by content, not by pointer: a rebuilt graph with the same
+// tensors in the same places matches).
+static uint64_t ggml_webgpu_graph_sig(const ggml_cgraph * g) {
+    uint64_t h   = 0x243f6a8885a308d3ull ^ (uint64_t) g->n_nodes;
+    auto     mix = [&h](uint64_t v) {
+        h = (h ^ v) * 0x9e3779b97f4a7c15ull;
+        h ^= h >> 31;
+    };
+    auto tensor = [&mix](const ggml_tensor * t) {
+        const ggml_tensor * b = t->view_src ? t->view_src : t;
+        mix((uint64_t) (uintptr_t) b->buffer);
+        mix((uint64_t) ((uintptr_t) b->data + t->view_offs));
+        mix((uint64_t) t->type | ((uint64_t) (t->view_src != nullptr) << 32));
+        for (int k = 0; k < GGML_MAX_DIMS; k++) {
+            mix((uint64_t) t->ne[k]);
+            mix((uint64_t) t->nb[k]);
+        }
+    };
+    for (int i = 0; i < g->n_nodes; i++) {
+        const ggml_tensor * n = g->nodes[i];
+        mix((uint64_t) n->op | ((uint64_t) n->flags << 16));
+        tensor(n);
+        const uint32_t * op = (const uint32_t *) n->op_params;
+        for (size_t k = 0; k < GGML_MAX_OP_PARAMS / sizeof(uint32_t); k += 2) {
+            mix((uint64_t) op[k] | ((uint64_t) op[k + 1] << 32));
+        }
+        for (int j = 0; j < GGML_MAX_SRC; j++) {
+            if (n->src[j]) {
+                mix(0x100 + j);
+                tensor(n->src[j]);
+            }
+        }
+    }
+    return h;
+}
